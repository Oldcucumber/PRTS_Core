{
  "name": "floor-direction-lab",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/preview.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:static": "npm run build && node tests/static.mjs",
    "test:camera": "npm run build && node tests/camera.mjs",
    "test:camera-selection": "npm run build && node tests/camera-selection.mjs",
    "test:depth": "npm run build && node tests/depth.mjs",
    "test:depth-comparison": "npm run build && node tests/depth-comparison.mjs",
    "test:session": "npm run build && node tests/session-browser.mjs",
    "test:fixtures": "node scripts/prepare-session-fixtures.mjs"
  },
  "dependencies": {
    "onnxruntime-web": "1.30.0"
  },
  "devDependencies": {
    "playwright": "1.58.2"
  }
}
